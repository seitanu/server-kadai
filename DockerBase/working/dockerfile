# 最新のUbuntu LTSイメージを取得（26.04 または 24.04 を指定可能）
FROM ubuntu:latest

# パッケージリストの更新とVimのインストール（キャッシュ削除で軽量化）
RUN apt-get update && \
    apt-get install -y --no-install-recommends vim && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 作業ディレクトリを /working に設定
WORKDIR /working

# コンテナ起動時にbashを開く
CMD ["/bin/bash"]